{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "poxme-inbox",
	// No workers.dev hostname. Production mail is mail.pox.me.
	"workers_dev": false,
	"compatibility_date": "2025-11-28",
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		// Sign-in is Logto at auth.pox.me. Set INTERNAL_SECRET before deploy.
		"DOMAINS": "mail.pox.me",
		"EMAIL_ADDRESSES": [],
		"LOGTO_ENDPOINT": "https://auth.pox.me",
		"TRUSTED_FIRST_PARTY_CLIENT_IDS": "rJRFhVAXTMYlAQeyiYkBC,poxme-webapp,poxme-credential-link",
		// Logto resource indicator for direct SPA tokens. api.pox.me calls use
		// the internal-secret bypass and do not exercise Logto.
		"API_AUDIENCE": "https://mail.pox.me"
		// MCP_ENABLED and AGENT_WEBSOCKET_ENABLED intentionally remain unset.
		// Do not enable them until DO names and all mailbox tool arguments are
		// enforced against the authenticated Logto subject.
		// Workers-AI model IDs are overridable via AI_MODEL_CHAT / AI_MODEL_INJECTION /
		// AI_MODEL_VERIFY (see workers/lib/ai-config.ts). Defaults are current as of 2026-07.
	},
	"send_email": [
		{
			"name": "EMAIL",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "poxme-emails",
			"preview_bucket_name": "poxme-emails"
		}
	],
	"d1_databases": [
		{
			"binding": "POXME_DB",
			"database_name": "poxme-api-db",
			"database_id": "34a5f51e-305e-4bbe-b0d3-bee9b4d4e43f"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "COMMS",
				"class_name": "CommsDO"
			},
			{
				"name": "EMAIL_AGENT",
				"class_name": "EmailAgent"
			},
			{
				"name": "EMAIL_MCP",
				"class_name": "EmailMCP"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"CommsDO"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"EmailAgent"
			]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"EmailMCP"
			]
		}
	]
}
